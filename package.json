{
  "name": "cookie-chain-app",
  "private": true,
  "version": "0.1.0",
  "description": "Cookie Chain cApp — wallet connect + cookie-mcp data dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"proxy,vite\" -c \"cyan,green\" \"npx tsx server/src/index.ts\" \"vite\"",
    "build": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.mjs",
    "lint": "eslint src server/src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json"
  },
  "workspaces": [
    "server"
  ],
  "dependencies": {
    "@solana-mobile/wallet-adapter-mobile": "2.3.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-nightly": "^0.1.8",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.98.0",
    "bs58": "6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.15.0",
    "playwright": "^1.63.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "@solana/wallet-adapter-react": {
      "@types/react": "^18.3.12"
    },
    "@solana/wallet-adapter-react-ui": {
      "@types/react": "^18.3.12"
    },
    "uuid": "^8.3.2"
  }
}
