# ── Cookie Chain cApp — environment variables ─────────────────────────────
#
# Copy this file to .env.local (git-ignored) and fill in values.
# NEVER commit .env.local or any file containing real keys.
#
# ── Frontend (Vite) — prefix all with VITE_ ──────────────────────────────

# Cookie Chain RPC endpoint (defaults to the public endpoint if unset)
VITE_COOKIE_RPC_URL=https://rpc.cookiescan.io

# ── Proxy server ──────────────────────────────────────────────────────────

# RPC URL forwarded to cookie-mcp (server-side, no VITE_ prefix)
COOKIE_RPC_URL=https://rpc.cookiescan.io

# Candy Shop aggregator base URL (default is the public endpoint)
# COOKIE_SWAP_API_URL=https://swap.cookiescan.io/api

# Port the proxy listens on (default: 3001)
# PORT=3001

# CORS origin for the proxy (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# ── NEVER add below this line ─────────────────────────────────────────────
# COOKIE_PRIVATE_KEY is only needed for swap/transfer (a future ticket).
# It must NEVER be committed. Set it in your shell env or a local .env only.
