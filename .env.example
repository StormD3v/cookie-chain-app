# ── Cookie Chain cApp — environment variables ─────────────────────────────
#
# Copy this file to .env.local (git-ignored) and fill in values.
# NEVER commit .env.local or any file containing real keys.
#
# For Vercel deployments, set these in:
#   Dashboard → Project → Settings → Environment Variables
# (not via a .env file — Vercel injects them at runtime)

# ── Frontend (Vite) — only needed locally; prefix with VITE_ ─────────────

# Cookie Chain RPC endpoint used by the frontend wallet adapter
VITE_COOKIE_RPC_URL=https://rpc.cookiescan.io

# ── Server (Express / Vercel serverless) ──────────────────────────────────

# RPC URL used server-side for balance and activity queries
COOKIE_RPC_URL=https://rpc.cookiescan.io

# Candy Shop aggregator base URL (default shown; override to use a staging endpoint)
# COOKIE_SWAP_API_URL=https://swap.cookiescan.io/api

# Local dev only — port the Express server listens on
# PORT=3001

# Local dev only — allowed CORS origin for the Express server
# CORS_ORIGIN=http://localhost:5173
